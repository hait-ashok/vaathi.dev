---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Free foundational AI skills for beginners — no account required.',
} = Astro.props;
const pageTitle = title === 'vaathi.dev' ? title : `${title} · vaathi.dev`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var allowed = { new: 1, it: 1, sales: 1 };
          var q = new URLSearchParams(location.search).get('lens');
          var stored = null;
          try {
            stored = localStorage.getItem('vaathi.lens');
          } catch (e) {}
          var lens = q && allowed[q] ? q : stored && allowed[stored] ? stored : 'new';
          document.documentElement.setAttribute('data-lens', lens);
          document.documentElement.setAttribute('data-lens-ready', 'ready');
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,650;1,9..144,500&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,650&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a class="site-wordmark" href="/">
          <img class="site-wordmark__mark" src="/logo.svg" width="28" height="28" alt="" />
          <span>vaathi.dev</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/learn">Learn</a>
          <a href="/about">About</a>
          <a href="/glossary">Glossary</a>
          <a class="site-cta" href="/learn/foundations">Start learning</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell site-footer__inner">
        <nav aria-label="Footer">
          <a href="/">Home</a>
          <a href="/learn">Learn</a>
          <a href="/about">About</a>
          <a href="/glossary">Glossary</a>
        </nav>
        <div class="site-footer__meta">
          <p class="site-footer__note">
            vaathi.dev is a free community primer.
            <a href="/about#license">MIT licensed</a>.
          </p>
          <p class="site-footer__credit">
            Powered by H&amp;A IT ·
            <a href="mailto:info@haitsolutions.co.uk">info@haitsolutions.co.uk</a>
            ·
            <a href="https://www.haitsolutions.co.uk" rel="noopener noreferrer">www.haitsolutions.co.uk</a>
          </p>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var lens = document.documentElement.getAttribute('data-lens') || 'new';
        document.querySelectorAll('[data-lens-choice]').forEach(function (input) {
          input.checked = input.value === lens;
        });
        var card = document.querySelector('.lens-card[data-lens="' + lens + '"]');
        if (card && card.getAttribute('data-relevance') === 'skim') {
          var prose = document.querySelector('.lesson-prose');
          if (prose) prose.classList.add('is-skim');
          var btn = document.querySelector('[data-lens-expand]');
          if (btn) btn.hidden = false;
        }
      })();
    </script>
    <script>
      import '../scripts/lens.ts';
    </script>
  </body>
</html>
