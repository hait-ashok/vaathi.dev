---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Why vaathi.dev exists — a free, open community primer for foundational AI skills."
>
  <div class="site-shell">
    <header class="page-header">
      <p class="mono-label">About</p>
      <h1>Curiosity, shared freely</h1>
      <p>
        vaathi.dev teaches foundational AI skills for beginners — clear mental models, safe habits,
        and practical first steps — without paywalls or accounts.
      </p>
    </header>

    <section class="section" aria-labelledby="mission">
      <h2 id="mission" class="section__title">Mission</h2>
      <p class="section__lede">
        Anyone should be able to land, learn the basics, and leave with confidence. We write for
        curious beginners and career switchers who need vocabulary and intuition before tools —
        not hype, not gatekeeping.
      </p>
    </section>

    <section class="section" aria-labelledby="who">
      <h2 id="who" class="section__title">Who builds this</h2>
      <p class="section__lede">
        vaathi.dev is created and maintained by H&amp;A. Content is H&amp;A-owned for now; a lighter
        community contribution process may come later.
      </p>
    </section>

    <section class="section" aria-labelledby="contribute">
      <h2 id="contribute" class="section__title">Suggest a topic</h2>
      <p class="section__lede">
        Missing a beginner question? Email
        <a href="mailto:hello@vaathi.dev">hello@vaathi.dev</a>
        with a short note. No account required — we read suggestions as they come.
      </p>
    </section>

    <section class="section" aria-labelledby="not">
      <h2 id="not" class="section__title">What we’re not</h2>
      <p class="section__lede">
        Not a paid cohort. Not a signup wall. Not an enterprise training marketplace. Just a free
        foundations path you can finish in an afternoon.
      </p>
      <p style="margin-top: 1.5rem">
        <a class="site-cta" href="/learn/foundations">Start Foundations</a>
      </p>
    </section>
  </div>
</BaseLayout>
