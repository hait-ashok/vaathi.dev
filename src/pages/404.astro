---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page isn’t here — head home or into Foundations.">
  <div class="site-shell page-header">
    <p class="mono-label">404</p>
    <h1>This page wandered off</h1>
    <p>The link may be old or mistyped. Start again from home, or jump into Foundations.</p>
    <p style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
      <a class="site-cta" href="/">Home</a>
      <a class="site-cta site-cta--ghost" href="/learn/foundations">Foundations</a>
    </p>
  </div>
</BaseLayout>
