---
import BaseLayout from '../layouts/BaseLayout.astro';

const terms = [
  {
    term: 'Model',
    def: 'Software trained on data that maps inputs to outputs (text, images, scores). You usually call a model through a product or API rather than training it yourself.',
  },
  {
    term: 'Gen AI',
    def: 'Generative AI — systems that create new content (text, images, audio, code) from a prompt or input, rather than only classifying or scoring existing items.',
  },
  {
    term: 'Label',
    def: 'A human- (or tool-) assigned answer attached to an example — a category, score, corrected text, or preference — used to train, evaluate, or fine-tune models.',
  },
  {
    term: 'Supervised learning',
    def: 'Training a model on examples that already have labels, so it learns to predict similar labels on new inputs.',
  },
  {
    term: 'Token',
    def: 'A chunk of text the model reads or writes — often a word piece, not always a whole word. Longer prompts and answers use more tokens.',
  },
  {
    term: 'Embedding',
    def: 'A list of numbers (a vector) that represents text or other media so similar meanings tend to sit nearby. Used for search, retrieval, and “more like this.”',
  },
  {
    term: 'Transformer',
    def: 'A model architecture that uses attention to weigh which parts of the input matter when predicting the next output. Common backbone for modern language models. Often stacked in many layers; chat products are frequently decoder-only.',
  },
  {
    term: 'Attention',
    def: 'A learned “spotlight” that weighs which tokens (or positions) matter when the model updates a representation or predicts the next token. Central idea behind transformers — compute-heavy at long context.',
  },
  {
    term: 'CPU',
    def: 'Central processing unit — strong at a few complex, branching tasks (running apps, orchestration, preprocessing). Not specialized for huge parallel matrix math the way GPUs/accelerators are.',
  },
  {
    term: 'GPU',
    def: 'Graphics processing unit — strong at many similar simple operations in parallel. Training and large-model inference lean on this shape of work (matrix multiplies). Other accelerators play a similar role.',
  },
  {
    term: 'Hallucination',
    def: 'When a model produces fluent text that is wrong or invented. Treat confident wording as a style, not a guarantee of truth.',
  },
  {
    term: 'Prompt',
    def: 'The instructions and context you give a model. Clear goals, constraints, and format usually beat “magic” one-liners.',
  },
  {
    term: 'Prompt engineering',
    def: 'Deliberately structuring and iterating prompts — goals, context, examples, constraints — so outputs are more useful. Habit and clarity, not secret spells.',
  },
  {
    term: 'BLEU',
    def: 'A classic metric for machine translation that scores overlap between a model’s output and human reference translations. (Sometimes misspelled “BLUE.”) Useful in labs; not a full measure of quality alone.',
  },
  {
    term: 'ROUGE',
    def: 'A family of metrics often used for summarization that score overlap with a human reference summary. Helpful for benchmarks; still incomplete without human judgment.',
  },
  {
    term: 'METEOR',
    def: 'A reference-based text metric that is often a bit more flexible than classic BLEU when matching related wording. Still needs human references and still incomplete alone.',
  },
  {
    term: 'BERTScore',
    def: 'An embedding-based metric that compares meaning similarity between a model output and a reference, rather than counting exact word overlap only.',
  },
  {
    term: 'Perplexity',
    def: 'A measure of how “surprised” a language model is by a piece of text. Useful for model fit; not a direct score of helpful chat answers.',
  },
  {
    term: 'F1',
    def: 'A single number balancing precision and recall for labeled (classification) tasks. Not the right default tool for open-ended free text.',
  },

  {
    term: 'Claude',
    def: 'Anthropic’s family of language models and related products (chat, API, Claude Code). Distinct from cloud platforms like AWS Bedrock, which may host Claude among other models.',
  },
  {
    term: 'Claude Code',
    def: 'Anthropic’s agentic coding tool (CLI and other surfaces) that can read and edit a project. Different from Claude chat. See official docs at code.claude.com for install.',
  },
  {
    term: 'Frontier model',
    def: 'A large general-purpose foundation model that products and agents call via a vendor or cloud API. Catalogs change; the access pattern matters more than any single brand.',
  },
  {
    term: 'Amazon Bedrock',
    def: 'An AWS managed platform for calling foundation models via AWS APIs, permissions, and billing. Not “Claude’s home” — Claude is one possible model choice among others.',
  },
  {
    term: 'API',
    def: 'A programmed interface an application calls to request work (for example, “generate text”) and receive a response — as opposed to a human-facing chat screen.',
  },
  {
    term: 'Agent',
    def: 'A system that uses a model plus tools (search, code, apps) to take multi-step actions. More power, more ways to go wrong — start simple.',
  },
  {
    term: 'Agentic workflow',
    def: 'A goal-driven loop: plan, act with tools, observe results, then loop or finish — unlike a single chat reply. Supervise carefully as a beginner.',
  },
  {
    term: 'Agent memory',
    def: 'Facts you store and feed back into the prompt on purpose — short-term message history, session summaries, or long-term prefs/notes outside the model. Not something the model invents by itself.',
  },
];
---

<BaseLayout
  title="Glossary"
  description="Short definitions for common AI terms used in the Foundations path."
>
  <div class="site-shell">
    <header class="page-header">
      <p class="mono-label">Reference</p>
      <h1>Glossary</h1>
      <p>
        Short definitions for terms you’ll meet in Foundations. IDs match lesson links (e.g.
        <code>#bleu</code>, <code>#amazon-bedrock</code>).
      </p>
    </header>

    <dl class="glossary-list">
      {
        terms.map(({ term, def }) => {
          const id = term.toLowerCase().replace(/\s+/g, '-');
          return (
            <div>
              <dt id={id}>{term}</dt>
              <dd>{def}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</BaseLayout>
