---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Learn"
  description="Learning paths on vaathi.dev — Foundations, Build, then Sandbox."
>
  <div class="site-shell">
    <header class="page-header">
      <p class="mono-label">Learn</p>
      <h1>Paths</h1>
      <p>
        Three stages: Foundations for ideas, Build for the code shape, Sandbox to run the loop.
      </p>
    </header>

    <ul class="path-list">
      <li>
        <a href="/learn/foundations">
          <span class="lesson-list__num" aria-hidden="true">01</span>
          <span>
            <span class="lesson-list__title">AI Foundations</span>
            <br />
            <span class="lesson-list__meta">22 lessons · concepts · free</span>
          </span>
          <span class="lesson-list__arrow" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="/learn/build">
          <span class="lesson-list__num" aria-hidden="true">02</span>
          <span>
            <span class="lesson-list__title">Build: Python to agents</span>
            <br />
            <span class="lesson-list__meta">8 lessons · real agent code before Sandbox</span>
          </span>
          <span class="lesson-list__arrow" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="/sandbox">
          <span class="lesson-list__num" aria-hidden="true">03</span>
          <span>
            <span class="lesson-list__title">Sandbox</span>
            <br />
            <span class="lesson-list__meta">3 scenarios · run the flow · free</span>
          </span>
          <span class="lesson-list__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </div>
</BaseLayout>
