---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LensSwitch from '../../../components/LensSwitch.astro';
import { LENSES, RELEVANCE_LABEL, relevanceFor } from '../../../lib/lenses';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons'))
    .filter((l) => l.data.path === 'foundations' && !l.data.draft)
    .sort((a, b) => a.data.order - b.data.order);

  return lessons.map((lesson, index) => ({
    params: { slug: lesson.id },
    props: {
      lesson,
      prev: index > 0 ? lessons[index - 1] : null,
      next: index < lessons.length - 1 ? lessons[index + 1] : null,
    },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
---

<BaseLayout title={lesson.data.title} description={lesson.data.description}>
  <div class="site-shell">
    <nav class="lesson-chrome" aria-label="Lesson">
      <a href="/learn/foundations">AI Foundations</a>
      <span>
        Lesson {lesson.data.order} · {lesson.data.minutes} min
      </span>
      <span>
        {
          prev ? (
            <a href={`/learn/foundations/${prev.id}`}>← Prev</a>
          ) : (
            <span aria-hidden="true"> </span>
          )
        }
        {' · '}
        {
          next ? (
            <a href={`/learn/foundations/${next.id}`}>Next →</a>
          ) : (
            <a href="/learn/foundations">Path</a>
          )
        }
      </span>
    </nav>

    <LensSwitch />

    <article class="lesson-article">
      <h1>{lesson.data.title}</h1>
      <p class="mono-label" style="margin-bottom: 1.5rem">{lesson.data.description}</p>
      <p class="lens-unframed">
        {
          LENSES.map((lens) => {
            const relevance = relevanceFor(lesson.id, lens.id);
            return (
              <span class="lens-mark" data-lens={lens.id} data-relevance={relevance}>
                {RELEVANCE_LABEL[relevance]}
              </span>
            );
          })
        }
        <span class="lens-unframed__hint">
          Tailored frame not written yet — this is the shared explanation.
        </span>
      </p>
      <div class="lesson-prose">
        <Content />
      </div>
      <p class="lens-expand-row">
        <button type="button" class="site-cta site-cta--ghost" data-lens-expand hidden aria-controls="lesson-body" aria-expanded="false">
          Read the full lesson
        </button>
      </p>

      <nav class="lesson-nav" aria-label="Continue">
        {
          prev ? (
            <a href={`/learn/foundations/${prev.id}`}>← {prev.data.title}</a>
          ) : (
            <a href="/learn/foundations">← All lessons</a>
          )
        }
        {
          next ? (
            <a href={`/learn/foundations/${next.id}`}>
              Next: {next.data.title} →
            </a>
          ) : (
            <a href="/learn/build">Stage 2: Build path →</a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>
