---
/**
 * One scene: a learner climbs a path through the AI ecosystem.
 * Waypoints sit on the path (models → tools → agents); not a side cluster.
 */
const pathD =
  'M95 340 C125 310, 145 285, 165 255 C190 215, 215 185, 250 155 C285 125, 320 100, 355 78';
---

<div class="learn-path-hero">
  <svg
    class="learn-path-hero__svg"
    viewBox="0 0 440 400"
    xmlns="http://www.w3.org/2000/svg"
    focusable="false"
  >
    <defs>
      <linearGradient id="learn-terrain" x1="20%" y1="100%" x2="80%" y2="0%">
        <stop offset="0%" stop-color="var(--teal-soft)" stop-opacity="0.95" />
        <stop offset="50%" stop-color="var(--mist-deep)" stop-opacity="0.55" />
        <stop offset="100%" stop-color="var(--cobalt-soft)" stop-opacity="0.85" />
      </linearGradient>
    </defs>

    <!-- Terrain the path climbs (ecosystem as mountain) -->
    <path
      class="learn-path-hero__terrain"
      d="M40 360
         C90 320, 110 280, 130 240
         C155 190, 190 150, 240 120
         C290 90, 330 70, 380 55
         L410 55 L410 360 Z"
      fill="url(#learn-terrain)"
      opacity="0.9"
    />
    <path
      d="M40 360
         C90 320, 110 280, 130 240
         C155 190, 190 150, 240 120
         C290 90, 330 70, 380 55"
      fill="none"
      stroke="var(--brand)"
      stroke-width="1.25"
      stroke-opacity="0.28"
    />

    <!-- Single ecosystem title for the whole scene -->
    <text class="learn-path-hero__eco-title" x="250" y="42" text-anchor="middle">
      AI ecosystem
    </text>

    <!-- Path underlay + route -->
    <path
      d={pathD}
      fill="none"
      stroke="var(--surface-quiet)"
      stroke-width="8"
      stroke-linecap="round"
      opacity="0.95"
    />
    <path
      class="learn-path-hero__route"
      d={pathD}
      fill="none"
      stroke="var(--brand)"
      stroke-width="2.75"
      stroke-linecap="round"
      stroke-opacity="0.85"
    />

    <!-- Trailhead -->
    <g transform="translate(95 340)">
      <circle r="11" fill="var(--surface-quiet)" stroke="var(--brand)" stroke-width="2" />
      <circle r="4" fill="var(--brand)" />
      <text class="learn-path-hero__micro" x="0" y="28" text-anchor="middle">start</text>
    </g>

    <!-- Waypoints ON the path (ecosystem the climber passes) -->
    <g class="learn-path-hero__way" transform="translate(165 255)">
      <circle r="16" fill="var(--surface-quiet)" stroke="var(--brand)" stroke-width="2" />
      <circle r="5" fill="var(--brand)" fill-opacity="0.9" />
      <text class="learn-path-hero__way-label" x="0" y="32" text-anchor="middle">models</text>
    </g>

    <g class="learn-path-hero__way learn-path-hero__way--mid" transform="translate(250 155)">
      <circle r="18" fill="var(--teal-soft)" stroke="var(--brand)" stroke-width="2.25" />
      <circle r="6" fill="var(--brand)" />
      <text class="learn-path-hero__way-label" x="0" y="34" text-anchor="middle">tools</text>
    </g>

    <g class="learn-path-hero__way" transform="translate(355 78)">
      <circle r="16" fill="var(--cobalt-soft)" stroke="var(--action)" stroke-width="2" stroke-opacity="0.75" />
      <circle r="5" fill="var(--action)" fill-opacity="0.85" />
      <text class="learn-path-hero__way-label" x="0" y="32" text-anchor="middle">agents</text>
    </g>

    <!-- Climber silhouette (larger, clearer) -->
    <g class="learn-path-hero__climber">
      <g transform="translate(-9 -28) scale(1.35)">
        <circle cx="8" cy="5" r="4.6" fill="var(--ink)" />
        <path d="M8 10.5 V22" stroke="var(--ink)" stroke-width="3.6" stroke-linecap="round" />
        <path d="M8 13.5 L16 8.5" stroke="var(--ink)" stroke-width="2.8" stroke-linecap="round" />
        <path d="M8 14.5 L1 19" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" />
        <path d="M8 22 L15 31" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
        <path d="M8 22 L2 32" stroke="var(--ink)" stroke-width="2.9" stroke-linecap="round" />
      </g>
    </g>
  </svg>
</div>

<style>
  .learn-path-hero {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    pointer-events: none;
    overflow: hidden;
  }

  .learn-path-hero__svg {
    width: min(58vw, 32rem);
    height: auto;
    margin-right: clamp(0rem, 3vw, 2rem);
  }

  .learn-path-hero__eco-title {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--brand);
    fill-opacity: 0.85;
  }

  .learn-path-hero__way-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--ink);
    fill-opacity: 0.78;
  }

  .learn-path-hero__micro {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--ink);
    fill-opacity: 0.55;
  }

  .learn-path-hero__route {
    stroke-dasharray: 12 14;
    animation: learn-path-dash 11s linear infinite;
  }

  .learn-path-hero__climber {
    offset-path: path('M95 340 C125 310, 145 285, 165 255 C190 215, 215 185, 250 155 C285 125, 320 100, 355 78');
    offset-rotate: auto 90deg;
    animation: learn-path-climb 13s ease-in-out infinite;
  }

  .learn-path-hero__way--mid {
    animation: learn-path-pulse 5.5s ease-in-out infinite;
  }

  .learn-path-hero__terrain {
    animation: learn-path-terrain 18s ease-in-out infinite alternate;
  }

  @keyframes learn-path-dash {
    to {
      stroke-dashoffset: -130;
    }
  }

  @keyframes learn-path-climb {
    0% {
      offset-distance: 1%;
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    93% {
      opacity: 1;
    }
    100% {
      offset-distance: 97%;
      opacity: 0;
    }
  }

  @keyframes learn-path-pulse {
    0%,
    100% {
      opacity: 0.92;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes learn-path-terrain {
    from {
      opacity: 0.82;
    }
    to {
      opacity: 0.95;
    }
  }

  @media (max-width: 719px) {
    .learn-path-hero {
      justify-content: center;
      align-items: flex-start;
    }

    .learn-path-hero__svg {
      width: min(96vw, 26rem);
      margin: 0.15rem auto 0;
      opacity: 0.92;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-path-hero__route,
    .learn-path-hero__climber,
    .learn-path-hero__way--mid,
    .learn-path-hero__terrain {
      animation: none !important;
    }

    .learn-path-hero__route {
      stroke-dasharray: none;
    }

    .learn-path-hero__climber {
      offset-distance: 50%;
      opacity: 1;
    }
  }
</style>
