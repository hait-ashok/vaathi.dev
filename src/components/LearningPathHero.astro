---
/**
 * Editorial hero visual: curiosity → understanding → growth
 * over a clearer layered mountain silhouette (no climber / ecosystem UI).
 */
---

<div class="learn-path-hero" aria-hidden="true">
  <svg
    class="learn-path-hero__svg"
    viewBox="0 0 440 400"
    xmlns="http://www.w3.org/2000/svg"
    focusable="false"
  >
    <defs>
      <linearGradient id="learn-mtn-back" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--mist-deep)" stop-opacity="0.95" />
        <stop offset="100%" stop-color="var(--cobalt-soft)" stop-opacity="0.9" />
      </linearGradient>
      <linearGradient id="learn-mtn-mid" x1="20%" y1="100%" x2="70%" y2="10%">
        <stop offset="0%" stop-color="var(--teal-soft)" stop-opacity="1" />
        <stop offset="100%" stop-color="var(--mist-deep)" stop-opacity="0.85" />
      </linearGradient>
      <linearGradient id="learn-mtn-front" x1="0%" y1="100%" x2="60%" y2="0%">
        <stop offset="0%" stop-color="var(--teal-soft)" stop-opacity="1" />
        <stop offset="55%" stop-color="var(--brand)" stop-opacity="0.18" />
        <stop offset="100%" stop-color="var(--mist-soft)" stop-opacity="0.95" />
      </linearGradient>
    </defs>

    <!-- Far range -->
    <path
      class="learn-path-hero__mtn learn-path-hero__mtn--back"
      d="M0 360 L55 250 L110 300 L175 175 L240 265 L300 145 L360 230 L420 120 L440 150 L440 400 L0 400 Z"
      fill="url(#learn-mtn-back)"
      stroke="var(--brand)"
      stroke-width="1.15"
      stroke-opacity="0.22"
    />

    <!-- Mid range -->
    <path
      class="learn-path-hero__mtn learn-path-hero__mtn--mid"
      d="M0 380 L70 280 L130 320 L190 210 L255 290 L320 185 L385 270 L440 200 L440 400 L0 400 Z"
      fill="url(#learn-mtn-mid)"
      stroke="var(--brand)"
      stroke-width="1.35"
      stroke-opacity="0.32"
    />

    <!-- Near foothills -->
    <path
      class="learn-path-hero__mtn learn-path-hero__mtn--front"
      d="M0 400 L40 330 L95 355 L150 285 L210 340 L270 270 L330 325 L390 275 L440 310 L440 400 Z"
      fill="url(#learn-mtn-front)"
      stroke="var(--brand)"
      stroke-width="1.5"
      stroke-opacity="0.4"
    />

    <!-- Sparse constellation (secondary) -->
    <g class="learn-path-hero__stars" fill="var(--brand)" fill-opacity="0.28">
      <circle cx="92" cy="88" r="2" />
      <circle cx="358" cy="72" r="1.75" />
      <circle cx="400" cy="180" r="2" />
      <circle cx="78" cy="260" r="1.5" />
    </g>

    <!-- Light idea links -->
    <g
      class="learn-path-hero__graph"
      fill="none"
      stroke="var(--rule)"
      stroke-width="1.15"
      stroke-opacity="0.95"
    >
      <path d="M168 118 L210 168" />
      <path d="M292 128 L250 168" />
      <path d="M210 168 L250 228" />
    </g>

    <!-- Path underlay for contrast on mountains -->
    <path
      d="M120 300 C150 250, 170 200, 210 168 C240 140, 260 110, 300 96"
      fill="none"
      stroke="var(--surface-quiet)"
      stroke-width="5"
      stroke-linecap="round"
      opacity="0.85"
    />

    <!-- Primary learning path -->
    <path
      class="learn-path-hero__route"
      d="M120 300 C150 250, 170 200, 210 168 C240 140, 260 110, 300 96"
      fill="none"
      stroke="var(--brand)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-opacity="0.78"
    />

    <circle class="learn-path-hero__traveler" r="3.25" fill="var(--action)" fill-opacity="0.75" />

    <!-- Stage 1 — curiosity -->
    <g class="learn-path-hero__stage learn-path-hero__stage--1" transform="translate(120 300)">
      <circle r="18" fill="var(--surface-quiet)" stroke="var(--brand)" stroke-width="1.5" stroke-opacity="0.65" />
      <circle r="5" fill="var(--brand)" fill-opacity="0.7" />
      <text class="learn-path-hero__label" x="0" y="36" text-anchor="middle">curiosity</text>
    </g>

    <!-- Stage 2 — understanding -->
    <g class="learn-path-hero__stage learn-path-hero__stage--2" transform="translate(210 168)">
      <circle r="22" fill="var(--teal-soft)" fill-opacity="0.95" stroke="var(--brand)" stroke-width="1.5" stroke-opacity="0.7" />
      <circle r="6" fill="var(--brand)" fill-opacity="0.75" />
      <circle cx="-28" cy="-8" r="3.5" fill="var(--brand)" fill-opacity="0.4" />
      <circle cx="30" cy="-14" r="3.5" fill="var(--action)" fill-opacity="0.45" />
      <circle cx="18" cy="26" r="3" fill="var(--brand)" fill-opacity="0.35" />
      <text class="learn-path-hero__label" x="0" y="42" text-anchor="middle">understanding</text>
    </g>

    <!-- Stage 3 — growth -->
    <g class="learn-path-hero__stage learn-path-hero__stage--3" transform="translate(300 96)">
      <circle r="16" fill="var(--cobalt-soft)" fill-opacity="0.95" stroke="var(--action)" stroke-width="1.5" stroke-opacity="0.55" />
      <circle r="4.5" fill="var(--action)" fill-opacity="0.75" />
      <path
        d="M22 -4 L34 -12 M22 -4 L30 6"
        fill="none"
        stroke="var(--action)"
        stroke-width="1.35"
        stroke-linecap="round"
        stroke-opacity="0.65"
      />
      <text class="learn-path-hero__label" x="0" y="34" text-anchor="middle">growth</text>
    </g>
  </svg>
</div>

<style>
  .learn-path-hero {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .learn-path-hero__svg {
    width: min(54vw, 30rem);
    height: auto;
    margin-right: clamp(0.5rem, 5vw, 3.5rem);
  }

  .learn-path-hero__label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--ink);
    fill-opacity: 0.68;
  }

  .learn-path-hero__route {
    stroke-dasharray: 8 12;
    animation: learn-path-draw 14s linear infinite;
  }

  .learn-path-hero__traveler {
    offset-path: path('M120 300 C150 250, 170 200, 210 168 C240 140, 260 110, 300 96');
    offset-rotate: 0deg;
    animation: learn-path-travel 9s ease-in-out infinite;
  }

  .learn-path-hero__stage {
    animation: learn-path-breathe 7s ease-in-out infinite;
  }

  .learn-path-hero__stage--2 {
    animation-delay: 1.4s;
  }

  .learn-path-hero__stage--3 {
    animation-delay: 2.8s;
  }

  .learn-path-hero__mtn--back {
    animation: learn-path-mtn 22s ease-in-out infinite alternate;
  }

  .learn-path-hero__mtn--mid {
    animation: learn-path-mtn 18s ease-in-out infinite alternate-reverse;
  }

  @keyframes learn-path-draw {
    to {
      stroke-dashoffset: -120;
    }
  }

  @keyframes learn-path-travel {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    10% {
      opacity: 0.85;
    }
    90% {
      opacity: 0.85;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes learn-path-breathe {
    0%,
    100% {
      opacity: 0.9;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes learn-path-mtn {
    from {
      opacity: 0.92;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 719px) {
    .learn-path-hero {
      justify-content: center;
      align-items: flex-start;
      padding-top: 0.25rem;
    }

    .learn-path-hero__svg {
      width: min(90vw, 24rem);
      margin: 0 auto;
      opacity: 0.78;
    }

    .learn-path-hero__label {
      font-size: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-path-hero__route,
    .learn-path-hero__traveler,
    .learn-path-hero__stage,
    .learn-path-hero__mtn--back,
    .learn-path-hero__mtn--mid {
      animation: none !important;
    }

    .learn-path-hero__route {
      stroke-dasharray: none;
    }

    .learn-path-hero__traveler {
      display: none;
    }

    .learn-path-hero__stage {
      opacity: 1;
    }
  }
</style>
