---
/**
 * Why embeddings: similar ideas sit nearby in vector space.
 */
---

<figure class="diagram diagram--anim">
  <figcaption class="diagram__caption">
    <span class="mono-label">Animation</span>
    Embeddings place similar meanings closer together
  </figcaption>
  <div class="diagram__frame">
    <svg
      class="diagram__svg"
      viewBox="0 0 560 260"
      role="img"
      aria-labelledby="emb-title emb-desc"
    >
      <title id="emb-title">Embeddings similarity</title>
      <desc id="emb-desc">
        Two similar phrases, dog and puppy, sit near each other. An unrelated phrase, invoice, sits
        farther away. Soft rings pulse around the nearby pair to show closeness.
      </desc>

      <rect x="16" y="20" width="528" height="220" rx="4" fill="var(--surface-quiet)" stroke="var(--rule)" />

      <!-- axes hint -->
      <path d="M60 210 H500 M60 210 V40" fill="none" stroke="var(--rule)" stroke-width="1.25" />
      <text class="diagram-hint" x="470" y="228" fill="var(--ink)">meaning space</text>

      <!-- similar cluster -->
      <circle class="emb-pulse" cx="200" cy="120" r="42" fill="var(--teal-soft)" fill-opacity="0.55" />
      <circle cx="185" cy="112" r="8" fill="var(--brand)" fill-opacity="0.85" />
      <text class="diagram-label" x="185" y="148" text-anchor="middle" fill="var(--ink)">dog</text>
      <circle cx="225" cy="128" r="8" fill="var(--brand)" fill-opacity="0.7" />
      <text class="diagram-label" x="225" y="164" text-anchor="middle" fill="var(--ink)">puppy</text>
      <text class="diagram-hint" x="205" y="88" text-anchor="middle" fill="var(--brand)">near</text>

      <!-- distant -->
      <circle cx="420" cy="70" r="8" fill="var(--action)" fill-opacity="0.55" />
      <text class="diagram-label" x="420" y="100" text-anchor="middle" fill="var(--ink)">invoice</text>
      <text class="diagram-hint" x="420" y="52" text-anchor="middle" fill="var(--ink)">far</text>

      <path
        class="emb-dash"
        d="M240 125 C300 110, 350 90, 405 75"
        fill="none"
        stroke="var(--rule)"
        stroke-width="1.25"
        stroke-dasharray="5 6"
      />
    </svg>
  </div>
  <p class="diagram__legend">Near = more similar meaning. Far = less related. No math required.</p>
</figure>

<style>
  .emb-pulse {
    animation: emb-pulse 3.5s ease-in-out infinite;
    transform-origin: 200px 120px;
  }
  .emb-dash {
    animation: emb-dash 8s linear infinite;
  }
  @keyframes emb-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.94);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.06);
    }
  }
  @keyframes emb-dash {
    to {
      stroke-dashoffset: -44;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .emb-pulse,
    .emb-dash {
      animation: none !important;
    }
    .emb-dash {
      stroke-dasharray: none;
    }
  }
</style>
