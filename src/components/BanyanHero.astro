---
/**
 * Trial hero atmosphere: banyan (wisdom / reliance / strength).
 * Soft, editorial SVG — not a product illustration or photo.
 * Turn off from index.astro: set showBanyanHero = false.
 */
---

<div class="hero-banyan">
  <svg
    class="hero-banyan__svg"
    viewBox="0 0 900 720"
    preserveAspectRatio="xMaxYMid slice"
    role="presentation"
    focusable="false"
  >
    <defs>
      <linearGradient id="banyan-canopy" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--teal-soft)" stop-opacity="0.95" />
        <stop offset="55%" stop-color="var(--mist-deep)" stop-opacity="0.85" />
        <stop offset="100%" stop-color="var(--cobalt-soft)" stop-opacity="0.7" />
      </linearGradient>
      <linearGradient id="banyan-trunk" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--ink)" stop-opacity="0.22" />
        <stop offset="50%" stop-color="var(--brand)" stop-opacity="0.28" />
        <stop offset="100%" stop-color="var(--ink)" stop-opacity="0.18" />
      </linearGradient>
      <radialGradient id="banyan-ground" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--mist-deep)" stop-opacity="0.55" />
        <stop offset="100%" stop-color="var(--mist-deep)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Ground wash -->
    <ellipse cx="620" cy="660" rx="280" ry="36" fill="url(#banyan-ground)" />

    <!-- Far canopy haze (depth) -->
    <ellipse class="hero-banyan__haze" cx="640" cy="180" rx="260" ry="120" fill="var(--teal-soft)" opacity="0.45" />
    <ellipse class="hero-banyan__haze" cx="520" cy="210" rx="180" ry="90" fill="var(--cobalt-soft)" opacity="0.35" />

    <!-- Main canopy — layered, editorial, not clip-art -->
    <g class="hero-banyan__canopy" fill="url(#banyan-canopy)" stroke="var(--brand)" stroke-opacity="0.12" stroke-width="1.25">
      <ellipse cx="610" cy="168" rx="210" ry="95" />
      <ellipse cx="490" cy="195" rx="140" ry="78" />
      <ellipse cx="730" cy="200" rx="150" ry="82" />
      <ellipse cx="560" cy="130" rx="120" ry="70" />
      <ellipse cx="680" cy="125" rx="130" ry="68" />
      <ellipse cx="640" cy="230" rx="190" ry="70" opacity="0.85" />
    </g>

    <!-- Soft leaf clusters (drift targets) -->
    <g class="hero-banyan__leaves" fill="var(--brand)" fill-opacity="0.14">
      <g transform="rotate(-25 470 150)"><ellipse class="hero-banyan__leaf" cx="470" cy="150" rx="18" ry="10" /></g>
      <g transform="rotate(15 520 115)"><ellipse class="hero-banyan__leaf" cx="520" cy="115" rx="16" ry="9" /></g>
      <g transform="rotate(-8 610 95)"><ellipse class="hero-banyan__leaf" cx="610" cy="95" rx="20" ry="11" /></g>
      <g transform="rotate(22 690 110)"><ellipse class="hero-banyan__leaf" cx="690" cy="110" rx="17" ry="10" /></g>
      <g transform="rotate(-18 750 155)"><ellipse class="hero-banyan__leaf" cx="750" cy="155" rx="19" ry="10" /></g>
      <g transform="rotate(12 780 210)"><ellipse class="hero-banyan__leaf" cx="780" cy="210" rx="15" ry="9" /></g>
      <g transform="rotate(-30 430 210)"><ellipse class="hero-banyan__leaf" cx="430" cy="210" rx="14" ry="8" /></g>
      <g transform="rotate(8 580 250)"><ellipse class="hero-banyan__leaf" cx="580" cy="250" rx="16" ry="9" /></g>
    </g>

    <!-- Trunk -->
    <path
      class="hero-banyan__trunk"
      d="M590 240
         C575 320, 568 400, 575 480
         C580 540, 590 600, 600 650
         L640 650
         C648 600, 655 540, 650 480
         C642 400, 648 320, 640 240
         Z"
      fill="url(#banyan-trunk)"
      stroke="var(--ink)"
      stroke-opacity="0.18"
      stroke-width="1.5"
    />

    <!-- Trunk grain (strength) -->
    <g fill="none" stroke="var(--ink)" stroke-opacity="0.12" stroke-width="1">
      <path d="M605 260 C598 360, 600 460, 608 620" />
      <path d="M625 255 C630 350, 628 470, 632 630" />
    </g>

    <!-- Aerial roots — reliance / pillars -->
    <g
      class="hero-banyan__roots"
      fill="none"
      stroke="var(--brand)"
      stroke-linecap="round"
      stroke-opacity="0.32"
    >
      <path class="hero-banyan__root" d="M520 220 C515 320, 505 420, 500 560 C498 600, 502 640, 510 655" stroke-width="2.25" />
      <path class="hero-banyan__root" d="M555 235 C548 340, 540 450, 545 580 C547 620, 552 645, 560 655" stroke-width="1.75" />
      <path class="hero-banyan__root" d="M675 230 C682 330, 690 450, 685 575 C683 615, 678 640, 670 655" stroke-width="2" />
      <path class="hero-banyan__root" d="M710 245 C720 350, 735 460, 740 575 C742 615, 738 640, 728 655" stroke-width="1.6" />
      <path class="hero-banyan__root" d="M480 250 C470 360, 455 480, 450 600 C448 630, 455 648, 465 655" stroke-width="1.4" />
      <path class="hero-banyan__root" d="M760 260 C775 370, 790 490, 785 600 C783 630, 775 648, 762 655" stroke-width="1.35" />
      <!-- finer hanging filaments -->
      <path class="hero-banyan__root hero-banyan__root--fine" d="M580 210 C572 300, 568 400, 570 500" stroke-width="1" stroke-opacity="0.22" />
      <path class="hero-banyan__root hero-banyan__root--fine" d="M650 205 C658 290, 662 390, 658 490" stroke-width="1" stroke-opacity="0.22" />
      <path class="hero-banyan__root hero-banyan__root--fine" d="M540 200 C532 280, 525 370, 528 460" stroke-width="0.9" stroke-opacity="0.2" />
    </g>

    <!-- Root feet meeting ground -->
    <g fill="var(--ink)" fill-opacity="0.12">
      <ellipse cx="510" cy="655" rx="14" ry="5" />
      <ellipse cx="560" cy="655" rx="12" ry="4.5" />
      <ellipse cx="670" cy="655" rx="13" ry="5" />
      <ellipse cx="728" cy="655" rx="11" ry="4" />
      <ellipse cx="465" cy="655" rx="10" ry="3.5" />
      <ellipse cx="762" cy="655" rx="10" ry="3.5" />
      <ellipse cx="620" cy="652" rx="28" ry="7" fill-opacity="0.1" />
    </g>
  </svg>

  <p class="hero-banyan__whisper" aria-hidden="true">rooted.</p>
</div>

<style>
  .hero-banyan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-banyan__svg {
    position: absolute;
    top: 0;
    right: 0;
    width: min(72vw, 52rem);
    height: 100%;
    opacity: 0.42;
    transform: translateX(4%);
  }

  .hero-banyan__whisper {
    position: absolute;
    right: clamp(1rem, 4vw, 2.5rem);
    bottom: clamp(1rem, 3vh, 2rem);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: var(--brand);
    opacity: 0.28;
  }

  .hero-banyan__leaf {
    animation: banyan-leaf 9s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hero-banyan__leaf:nth-child(2) {
    animation-delay: 1.2s;
    animation-duration: 11s;
  }
  .hero-banyan__leaf:nth-child(3) {
    animation-delay: 2.1s;
    animation-duration: 10s;
  }
  .hero-banyan__leaf:nth-child(4) {
    animation-delay: 0.6s;
    animation-duration: 12s;
  }
  .hero-banyan__leaf:nth-child(5) {
    animation-delay: 3s;
    animation-duration: 9.5s;
  }
  .hero-banyan__leaf:nth-child(6) {
    animation-delay: 1.8s;
  }
  .hero-banyan__leaf:nth-child(7) {
    animation-delay: 2.6s;
    animation-duration: 10.5s;
  }
  .hero-banyan__leaf:nth-child(8) {
    animation-delay: 0.3s;
  }

  .hero-banyan__root {
    animation: banyan-root 7s ease-in-out infinite;
  }
  .hero-banyan__root:nth-child(2) {
    animation-delay: 1.1s;
  }
  .hero-banyan__root:nth-child(3) {
    animation-delay: 2s;
  }
  .hero-banyan__root:nth-child(4) {
    animation-delay: 0.7s;
  }
  .hero-banyan__root--fine {
    animation-duration: 9s;
  }

  .hero-banyan__haze {
    animation: banyan-haze 18s ease-in-out infinite alternate;
  }

  @keyframes banyan-leaf {
    0%,
    100% {
      opacity: 0.5;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(2.5px);
    }
  }

  @keyframes banyan-root {
    0%,
    100% {
      stroke-opacity: 0.22;
    }
    50% {
      stroke-opacity: 0.4;
    }
  }

  @keyframes banyan-haze {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 0.5;
    }
  }

  @media (max-width: 719px) {
    .hero-banyan__svg {
      width: 115%;
      max-width: none;
      opacity: 0.22;
      transform: translateX(28%) translateY(6%);
    }

    .hero-banyan__whisper {
      opacity: 0.18;
      right: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banyan__leaf,
    .hero-banyan__root,
    .hero-banyan__haze {
      animation: none !important;
    }
  }
</style>
